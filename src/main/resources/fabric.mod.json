{
  "schemaVersion": 1,
  "id": "projectexpansion",
  "version": "${version}",
  "name": "ProjectExpansionNeo",
  "description": "ProjectExpansionNeo expands ProjectEF Neo with additional EMC machines, storage and utilities on Fabric.",
  "authors": ["Chiway Wang"],
  "contributors": ["Donovan_DMC"],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["cool.furry.mc.neoforge.projectexpansion.Main"],
    "client": ["cool.furry.mc.neoforge.projectexpansion.client.Client"],
    "jei_mod_plugin": ["cool.furry.mc.neoforge.projectexpansion.integrations.jei.JeiPlugin"],
    "emi": ["cool.furry.mc.neoforge.projectexpansion.integrations.emi.EmiPlugin"],
    "jade": ["cool.furry.mc.neoforge.projectexpansion.integrations.jade.JadePlugin"]
  },
  "mixins": ["projectexpansion.mixins.json"],
  "accessWidener": "projectexpansion.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.9",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21",
    "projecte": ">=1.3.0",
    "forgeconfigapiport": ">=21.1.0",
    "fabric-permissions-api-v0": "*"
  },
  "suggests": {"jei": "*", "emi": "*", "jade": "*", "wthit": "*", "trinkets": "*"}
}
